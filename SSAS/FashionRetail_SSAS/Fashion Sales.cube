  <Source dwd:design-time-name="cdb70071-f96e-40dd-a1ba-8d9dc3fca10b">
    <DataSourceViewID>DSV_Fashion_DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="46a63e0e-04de-4eff-83d9-b1a743f22cab">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE; CREATE MEMBER CURRENTCUBE.[Measures].[AOV]
AS
    IIF(
        ([Measures].[Invoice Count],
         [Dim Payment].[Transaction Type].&amp;[Sale]) = 0,
        NULL,
        [Measures].[Net Amount USD]
        /
        ([Measures].[Invoice Count],
         [Dim Payment].[Transaction Type].&amp;[Sale])
    ),
FORMAT_STRING = '#,##0.00',
VISIBLE = 1; 
CREATE MEMBER CURRENTCUBE.[Measures].UPT
 AS IIF(
    ([Measures].[Invoice Count],
     [Dim Payment].[Transaction Type].&amp;[Sale]) = 0,
    NULL,
    (
        [Measures].[Quantity],
        [Dim Payment].[Transaction Type].&amp;[Sale]
    )
    /
    (
        [Measures].[Invoice Count],
        [Dim Payment].[Transaction Type].&amp;[Sale]
    )
), 
FORMAT_STRING = "#.##0,00;-#.##0,00", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>